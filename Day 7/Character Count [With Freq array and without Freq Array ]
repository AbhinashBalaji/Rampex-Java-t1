// With Frequency Array
import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        String str=sc.nextLine();
        int[] freq=new int[256];
        for(int i=0;i<str.length();i++){
            char ch=str.charAt(i);
            freq[ch]++;
        }
        for(int i=0;i<256;i++){
            if(freq[i]!=0) {
            System.out.println((char)i+":"+freq[i]);
            }
        }
    }
}
// Withhout Frequency Array

import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        String str=sc.nextLine();
       for(int i=0;i<str.length();i++){
           char ch=str.charAt(i);
           boolean flag=false;
           int count=1;
           for(int j=0;j<i;j++){
               if(ch==str.charAt(j)){
                   flag=true;
                   break;
               }
           }
           if(flag)continue;
           for(int k=i+1;k<str.length();k++){
               if(ch==str.charAt(k))count++;
               
           }
           if(str.charAt(i)==' ')System.out.println("Space :"+count);
           else System.out.println(str.charAt(i)+":"+count);
       }
    }
}
